---
// Signup: email (double opt-in, POST /api/signup/email) or an AT Protocol account (Bluesky or any PDS).
// The AT Protocol path signs in with OAuth in the browser, then /oauth/callback asks what to do: follow the project
// account and/or add a public supporter record. No password or email is shared with us on that path.
interface Props {
  compact?: boolean;
  id?: string; // unique per page when the form appears twice (home + footer)
}
const { compact = false, id = "signup" } = Astro.props;
---
<form class:list={["signup", { compact }]} data-signup novalidate aria-labelledby={`${id}-title`}>
  <p id={`${id}-title`} class="title">{compact ? "Get updates" : "Follow the project"}</p>
  {!compact && <p class="sub">Occasional updates when new maps, data or analysis are published. No spam, and you can leave anytime.</p>}
  <div class="tabs" role="radiogroup" aria-label="Sign up with">
    <label><input type="radio" name="via" value="email" checked /> <span>Email</span></label>
    <label><input type="radio" name="via" value="atproto" /> <span>Bluesky / AT Protocol</span></label>
  </div>
  <div class="row" data-via="email">
    <label class="vh" for={`${id}-email`}>Email address</label>
    <input id={`${id}-email`} name="email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" />
    {!compact && <><label class="vh" for={`${id}-zip`}>ZIP code (optional)</label><input class="zip" id={`${id}-zip`} name="zip" type="text" inputmode="numeric" maxlength="5" autocomplete="postal-code" placeholder="ZIP (optional)" /></>}
    <button type="submit">Notify me</button>
  </div>
  <div class="row" data-via="atproto" hidden>
    <label class="vh" for={`${id}-handle`}>Bluesky or AT Protocol handle</label>
    <input id={`${id}-handle`} name="handle" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" placeholder="you.bsky.social" />
    <button type="submit">Continue</button>
  </div>
  <!-- honeypot for bots; hidden from people and screen readers -->
  <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <p class="note" data-note role="status" aria-live="polite">
    <span data-hint="email">We'll email you once to confirm, then only for project updates. <a href="/privacy">Privacy</a></span>
    <span data-hint="atproto" hidden>Sign in with Bluesky or any AT Protocol account; you choose what happens next. No email needed. <a href="/privacy">Privacy</a></span>
  </p>
</form>

<style>
  .signup {
    font: 15px/1.45 var(--font-body);
    color: var(--ink);
  }
  .title {
    margin: 0 0 4px;
    font: 700 20px/1.2 var(--font-display);
    letter-spacing: -0.01em;
  }
  .compact .title {
    font-size: 15px;
    margin-bottom: 10px;
  }
  .sub {
    margin: 0 0 14px;
    color: var(--muted);
  }
  .tabs {
    display: inline-flex;
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 3px;
    margin-bottom: 10px;
    background: var(--ground);
  }
  .tabs label {
    position: relative;
    cursor: pointer;
  }
  .tabs input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .tabs span {
    display: block;
    padding: 6px 12px;
    border-radius: 5px;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
  }
  .tabs input:checked + span {
    background: var(--ink);
    color: var(--panel);
  }
  .tabs input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .row {
    display: flex;
    gap: 8px;
  }
  .row[hidden] {
    display: none;
  }
  .row input {
    flex: 1;
    min-width: 0;
    height: 44px;
    padding: 0 12px;
    border: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
    border-radius: 6px;
    background: var(--ground);
    color: var(--ink);
    font: 16px var(--font-body);
  }
  .row input[aria-invalid="true"] {
    border-color: var(--bad);
  }
  .row button {
    height: 44px;
    padding: 0 18px;
    border: 0;
    border-radius: 6px;
    background: var(--accent);
    color: #fff;
    font: 600 15px var(--font-body);
    cursor: pointer;
    white-space: nowrap;
  }
  .row button:hover {
    filter: brightness(1.12);
  }
  .row input:focus-visible,
  .row button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .note {
    margin: 8px 0 0;
    min-height: 1.45em;
    font-size: 13px;
    color: var(--muted);
  }
  .note.ok {
    color: var(--good);
  }
  .note.err {
    color: var(--bad);
  }
  .compact .tabs span {
    padding: 5px 10px;
    font-size: 13px;
  }
  .row .zip {
    flex: 0 0 120px;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .note a {
    color: inherit;
  }
  @media (max-width: 480px) {
    .row { flex-wrap: wrap; }
    .row .zip { flex: 1 1 100px; }
  }
  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  import { OAUTH_SCOPE, oauthClientId } from "../lib/atproto/config";

  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  // AT Protocol handle: a domain name, e.g. alice.bsky.social or alice.com (a leading @ is allowed and stripped)
  const HANDLE = /^(?=.{3,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]$/i;

  // messages after the email confirmation / unsubscribe links (they land on /?signup=…#updates)
  const flash = new URLSearchParams(location.search).get("signup");
  const FLASH = { confirmed: "You're confirmed. Thanks for following the project!", unsubscribed: "You've been unsubscribed. You won't get any more emails.", followed: "Thanks for following the project!", invalid: "That link has expired or was already used. Sign up again below if you'd like." };

  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-signup]")) {
    const note = form.querySelector<HTMLElement>("[data-note]")!;
    const via = () => form.querySelector<HTMLInputElement>('input[name="via"]:checked')?.value ?? "email";
    const say = (kind: "ok" | "err" | "", text: string) => {
      note.className = "note" + (kind ? " " + kind : "");
      note.querySelectorAll<HTMLElement>("[data-hint]").forEach((h) => (h.hidden = !!text || h.dataset.hint !== via()));
      note.querySelector("[data-msg]")?.remove();
      if (text) { const m = document.createElement("span"); m.dataset.msg = ""; m.textContent = text; note.append(m); }
    };
    const show = () => { for (const el of form.querySelectorAll<HTMLElement>("[data-via]")) el.hidden = el.dataset.via !== via(); say("", ""); };
    form.addEventListener("change", (e) => { if ((e.target as HTMLInputElement).name === "via") show(); });
    if (flash && FLASH[flash as keyof typeof FLASH] && !form.classList.contains("compact")) say(flash === "invalid" ? "err" : "ok", FLASH[flash as keyof typeof FLASH]);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>(`[data-via="${via()}"] button`)!;
      if (via() === "email") {
        const input = form.querySelector<HTMLInputElement>('input[name="email"]')!;
        const zip = form.querySelector<HTMLInputElement>('input[name="zip"]')?.value.trim() ?? "";
        const email = input.value.trim();
        if (!EMAIL.test(email)) { input.setAttribute("aria-invalid", "true"); input.focus(); return say("err", "Please enter a valid email address."); }
        if (zip && !/^\d{5}$/.test(zip)) return say("err", "ZIP codes have 5 digits (or leave it blank).");
        input.removeAttribute("aria-invalid"); btn.disabled = true;
        try {
          const res = await fetch("/api/signup/email", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ email, zip, website: (form.elements.namedItem("website") as HTMLInputElement)?.value }) });
          const out = await res.json().catch(() => ({}));
          if (!res.ok || !out.ok) return say("err", out.error || "Something went wrong. Please try again.");
          input.value = "";
          say("ok", out.confirm ? "Almost done: check your inbox for a confirmation link." : "You're already signed up. Thanks!");
        } catch { say("err", "Couldn't reach the server. Please try again."); }
        finally { btn.disabled = false; }
      } else {
        const input = form.querySelector<HTMLInputElement>('input[name="handle"]')!;
        const handle = input.value.trim().replace(/^@/, "");
        if (!HANDLE.test(handle)) { input.setAttribute("aria-invalid", "true"); input.focus(); return say("err", "Please enter a handle like you.bsky.social."); }
        input.removeAttribute("aria-invalid");
        // the AT Protocol loopback client used in development must run on 127.0.0.1, not localhost
        if (location.hostname === "localhost") { location.href = location.href.replace("//localhost", "//127.0.0.1"); return; }
        btn.disabled = true; say("", "Opening your account's sign-in page…");
        try {
          const { BrowserOAuthClient } = await import("@atproto/oauth-client-browser");
          const client = await BrowserOAuthClient.load({ clientId: oauthClientId(location), handleResolver: "https://bsky.social" });
          sessionStorage.setItem("zd-oauth-return", location.pathname);
          await client.signIn(handle, { scope: OAUTH_SCOPE }); // navigates away; returns only on failure
        } catch (err) {
          console.error(err);
          say("err", "Couldn't start sign-in for that handle. Check it and try again.");
          btn.disabled = false;
        }
      }
    });
  }
</script>
