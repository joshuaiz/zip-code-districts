---
import "../styles/global.css";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ZIP Code Districts</title>
    <link rel="icon" href="data:," />
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-900 dark:bg-slate-900 dark:text-slate-100">
    <main class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center gap-8 px-6 py-16">
      <header class="space-y-3">
        <h1 class="text-4xl font-extrabold tracking-tight">ZIP Code Districts</h1>
        <p class="text-lg text-slate-600 dark:text-slate-400">
          U.S. House districts built by aggregating adjacent ZIP Code Tabulation Areas, with four
          non-partisan seeding strategies.
        </p>
      </header>
      <nav class="grid gap-4 sm:grid-cols-2">
        <a
          href="/districts"
          class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-slate-400 hover:shadow-md dark:border-slate-700 dark:bg-slate-800"
        >
          <span class="block text-lg font-semibold">Interactive map →</span>
          <span class="block text-sm text-slate-500 dark:text-slate-400">React + MapLibre island</span>
        </a>
        <a
          href="/standalone.html"
          class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-slate-400 hover:shadow-md dark:border-slate-700 dark:bg-slate-800"
        >
          <span class="block text-lg font-semibold">Standalone map →</span>
          <span class="block text-sm text-slate-500 dark:text-slate-400">Plain HTML, no build step</span>
        </a>
      </nav>
    </main>
  </body>
</html>
