---
// Example page. Copy /public/data from this bundle into your site's /public/data.
import ZipDistrictMap from "../components/ZipDistrictMap";
import "../styles/global.css";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ZIP Code Districts</title>
    <link rel="icon" href="data:," />
  </head>
  <body class="m-0 h-screen bg-slate-100">
    <main class="h-full">
      <!-- client:only because MapLibre needs the browser (WebGL, window) -->
      <ZipDistrictMap client:only="react" dataUrl="/data" initialStrategy="nw" />
    </main>
  </body>
</html>
