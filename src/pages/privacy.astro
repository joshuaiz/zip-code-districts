import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
const CONTACT = "privacy@zipcodedistricts.org"; // TODO: confirm this mailbox exists before launch
---
<Base title="Privacy · ZIP Code Districts" description="What ZIP Code Districts collects when you sign up for updates, and what it doesn't.">
  <div class="min-h-full bg-[var(--ground)] font-sans text-[var(--ink)]">
    <SiteHeader />
    <article class="prose dark:prose-invert prose-a:text-[var(--accent)] max-w-3xl mx-auto px-4 py-10">
      <h1>Privacy</h1>
      <p><em>Effective date: to be set at launch.</em></p>
      <p>ZIP Code Districts is an independent, open-source project. The map and all of its data work without an account, cookies or tracking. This page covers what happens if you sign up for updates.</p>

      <h2>Email signups</h2>
      <ul>
        <li><b>What we keep:</b> your email address, the ZIP code if you enter one, and the date. We email you once to confirm; nothing more is sent until you click the link.</li>
        <li><b>Spam protection:</b> a salted hash of your network address is stored with the signup so the same network can't submit many signups an hour. The address itself isn't stored.</li>
        <li><b>Use:</b> occasional project updates. Every email has an unsubscribe link that takes effect right away.</li>
        <li><b>Sending:</b> confirmation and update emails are sent through an email delivery provider (currently Resend), which processes your address only to deliver them.</li>
      </ul>

      <h2>Bluesky and AT Protocol signups</h2>
      <ul>
        <li><b>Sign-in:</b> you sign in on your own account's server (Bluesky or any other). We never see your password or email address.</li>
        <li><b>Access we ask for:</b> permission only to create a follow of the project account and, if you choose, one supporter record. We can't read your posts or messages or change anything else.</li>
        <li><b>Public records:</b> follows and supporter records are public on the AT Protocol network by design. Anyone can see them, and you can delete them from your account at any time. The supporter record contains no location.</li>
        <li><b>What we keep:</b> your account identifier (DID) and handle, links to the follow or supporter record you created, and the ZIP code if you enter one. The ZIP code is private: it is never published and never added to your account.</li>
        <li><b>No ongoing access:</b> we sign out of your account as soon as the signup is done, so we hold no access to it afterward.</li>
      </ul>

      <h2>What we publish</h2>
      <p>Only totals: how many people have signed up, and counts by state or district when there are enough to keep individuals anonymous. Never names, addresses, handles or ZIP codes from private signups.</p>

      <h2>What we don't do</h2>
      <ul>
        <li>No advertising, no tracking cookies, no selling or sharing of signup data.</li>
        <li>The map remembers your theme, projection and legend choices in your own browser (local storage). That stays on your device.</li>
      </ul>

      <h2>Services that handle requests</h2>
      <p>The site is hosted on Cloudflare, which processes requests to serve it. The typefaces load from Google Fonts. Each of these services sees the network address of your browser when it loads the page.</p>

      <h2>Deleting your data</h2>
      <p>Unsubscribe with the link in any email, or write to <a href={`mailto:${CONTACT}`}>{CONTACT}</a> to have your signup deleted. For AT Protocol signups, delete the follow or supporter record from your account and email us to remove the stored entry.</p>

      <h2>Children</h2>
      <p>Signups are not intended for children under 13.</p>

      <h2>Changes</h2>
      <p>If this policy changes, the new version will be posted here with a new effective date. Material changes will be emailed to confirmed subscribers.</p>
    </article>
    <SiteFooter />
  </div>
</Base>

<style is:global>
  body { height: auto; min-height: 100%; }
</style>
