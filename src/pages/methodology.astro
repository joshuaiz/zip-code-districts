---
// /methodology: how the districts are drawn. The text is src/content/methodology.md; its section headings are
// raw <h2 id>/<h3 id> so the map can deep-link to them (/methodology#mode-<id>, from "How this mode works →").
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { Content, frontmatter } from "../content/methodology.md";

---
<Base title={frontmatter.title} description={frontmatter.description}>
  <div class="min-h-full bg-[var(--ground)] font-sans text-[var(--ink)]">
    <SiteHeader current="methodology" />
    <article
      class="prose dark:prose-invert prose-a:text-[var(--accent)] prose-a:decoration-[color-mix(in_srgb,var(--accent)_40%,transparent)] prose-a:underline-offset-2 hover:prose-a:decoration-[var(--accent)] prose-h1:tracking-tight prose-table:text-sm max-w-3xl mx-auto px-4 py-8"
    >
      <Content />
    </article>
    <SiteFooter />
  </div>
</Base>

<style is:global>
  /* Base sets html, body { height: 100% } for the full-screen map. Here the page scrolls. */
  body {
    height: auto;
    min-height: 100%;
  }
  /* a little air above deep-linked headings (#mode-splitline etc.) */
  .prose :is(h2, h3)[id] {
    scroll-margin-top: 1.25rem;
  }
  /* wide tables scroll sideways on narrow screens instead of widening the page */
  .prose table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }
  /* headers may wrap ("Average / deviation") so the table fits the column on desktop; values stay on one line */
  .prose td {
    white-space: nowrap;
  }
</style>
